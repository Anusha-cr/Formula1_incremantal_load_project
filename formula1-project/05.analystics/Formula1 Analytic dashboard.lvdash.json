    {
      "name": "9c84b91b",
      "displayName": "dominant drivers dashboard",
      "queryLines": [
        "WITH driver_metrics AS\r\n",
        "(\r\n",
        "SELECT driver_name,\r\n",
        "SUM(race_starts) AS races_starts,\r\n",
        "SUM(number_of_wins) AS total_wins,\r\n",
        "SUM(number_of_podiums) AS total_podiums,\r\n",
        "SUM(CASE WHEN standing == 1 THEN 1 ELSE 0 END) AS total_championships\r\n",
        "FROM formual1.gold.veiw_driver_standing\r\n",
        "GROUP BY driver_name\r\n",
        "HAVING total_championships >= 1)\r\n",
        "SELECT driver_name,\r\n",
        "races_starts,\r\n",
        "total_wins,\r\n",
        "total_podiums,\r\n",
        "total_championships,\r\n",
        "(total_championships * 100) + (total_wins * 10) + (total_podiums * 3) AS greatness_score\r\n",
        "FROM driver_metrics\r\n",
        "ORDER BY greatness_score DESC;"
      ]
    },
    {
      "name": "62017a29",
      "displayName": "Untitled dataset",
      "queryLines": [
        ""
      ]
    },
    {
      "name": "40e67062",
      "displayName": "dominant constructor dashboard",
      "queryLines": [
        "WITH constructor_metrics AS (\r\n",
        "  SELECT\r\n",
        "    constructor_name,\r\n",
        "    SUM(race_starts) AS races_starts,\r\n",
        "    SUM(number_of_wins) AS total_wins,\r\n",
        "    SUM(number_of_podiums) AS total_podiums,\r\n",
        "    SUM(CASE WHEN standing = 1 THEN 1 ELSE 0 END) AS total_championships\r\n",
        "  FROM formual1.gold.veiw_constructor_standing\r\n",
        "  GROUP BY constructor_name\r\n",
        "  HAVING total_championships >=1 \r\n",
        ")\r\n",
        "SELECT\r\n",
        "  constructor_name,\r\n",
        "  races_starts,\r\n",
        "  total_wins,\r\n",
        "  total_podiums,\r\n",
        "  total_championships,\r\n",
        "  (total_championships * 100) + (total_wins * 10) + (total_podiums * 3) AS greatness_score\r\n",
        "FROM constructor_metrics\r\n",
        "ORDER BY greatness_score DESC\r\n",
        "LIMIT 10;"
      ]
    }
  ],
